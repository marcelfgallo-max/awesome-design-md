{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "MG Works Design System",
  "version": "1.0.0",
  "status": "draft",
  "scope": ["MG Works", "Northbound Financial Intelligence"],
  "source": {
    "brand": "branding/mgworks-v1 and branding/northbound-v2",
    "reference": "https://www.behance.net/gallery/255636053/DEVENZ-STUDIO",
    "referenceAccessed": "2026-09-22"
  },
  "color": {
    "brand": {
      "orange": { "$value": "#FA5002", "$type": "color", "$description": "Laranja aprovado na identidade visual MG Works e Northbound." },
      "black": { "$value": "#000000", "$type": "color" },
      "white": { "$value": "#FFFFFF", "$type": "color" }
    },
    "reference": {
      "charcoal": { "$value": "#252424", "$type": "color" },
      "mist": { "$value": "#CACBD2", "$type": "color" },
      "gray": { "$value": "#DADCE0", "$type": "color" },
      "blaze": { "$value": "#F67300", "$type": "color", "$description": "Cor observada na prancha cromática da referência." },
      "cyan": { "$value": "#A3D6F4", "$type": "color" }
    },
    "ink": {
      "strong": { "$value": "#111111", "$type": "color" },
      "default": { "$value": "#252424", "$type": "color" },
      "muted": { "$value": "#62666B", "$type": "color" },
      "subtle": { "$value": "#858A90", "$type": "color" }
    },
    "border": {
      "strong": { "$value": "#8E9399", "$type": "color" },
      "default": { "$value": "#CACBD2", "$type": "color" },
      "subtle": { "$value": "#E6E7E9", "$type": "color" }
    },
    "surface": {
      "page": { "$value": "#F4F4F2", "$type": "color" },
      "raised": { "$value": "#FFFFFF", "$type": "color" },
      "soft": { "$value": "#ECEDEE", "$type": "color" },
      "inverse": { "$value": "#000000", "$type": "color" }
    },
    "feedback": {
      "success": { "$value": "#176B45", "$type": "color" },
      "successSoft": { "$value": "#E4F2EA", "$type": "color" },
      "warning": { "$value": "#835000", "$type": "color" },
      "warningSoft": { "$value": "#FFF1D8", "$type": "color" },
      "danger": { "$value": "#B42318", "$type": "color" },
      "dangerSoft": { "$value": "#FDE8E7", "$type": "color" },
      "info": { "$value": "#005A86", "$type": "color" },
      "infoSoft": { "$value": "#E2F3FA", "$type": "color" }
    },
    "signalGradient": {
      "$value": "linear-gradient(90deg, #FA5002 0%, #CACBD2 54%, #A3D6F4 100%)",
      "$type": "other",
      "$description": "Acento gráfico curto para divisores e transições, não usar como fundo de texto nem no logotipo."
    }
  },
  "typography": {
    "family": {
      "sans": { "$value": "Archivo, Arial, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "IBM Plex Mono, Courier New, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "caption": { "$value": "11px", "$type": "dimension" },
      "label": { "$value": "12px", "$type": "dimension" },
      "small": { "$value": "14px", "$type": "dimension" },
      "body": { "$value": "16px", "$type": "dimension" },
      "lead": { "$value": "18px", "$type": "dimension" },
      "titleSmall": { "$value": "24px", "$type": "dimension" },
      "titleMedium": { "$value": "32px", "$type": "dimension" },
      "titleLarge": { "$value": "40px", "$type": "dimension" },
      "display": { "$value": "clamp(48px, 7vw, 88px)", "$type": "other" }
    },
    "lineHeight": {
      "tight": { "$value": 1.05, "$type": "number" },
      "heading": { "$value": 1.12, "$type": "number" },
      "body": { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.65, "$type": "number" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "20": { "$value": "80px", "$type": "dimension" }
  },
  "shape": {
    "borderWidthHairline": { "$value": "1px", "$type": "dimension" },
    "borderWidthStrong": { "$value": "2px", "$type": "dimension" },
    "radiusNone": { "$value": "0px", "$type": "dimension" },
    "radiusXs": { "$value": "2px", "$type": "dimension" },
    "radiusSm": { "$value": "4px", "$type": "dimension" },
    "radiusMd": { "$value": "8px", "$type": "dimension" },
    "radiusLg": { "$value": "12px", "$type": "dimension" },
    "radiusPill": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "card": { "$value": "0 1px 2px rgb(0 0 0 / 8%)", "$type": "shadow" },
    "overlay": { "$value": "0 16px 48px rgb(0 0 0 / 18%)", "$type": "shadow" }
  },
  "motion": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "base": { "$value": "180ms", "$type": "duration" },
    "slow": { "$value": "260ms", "$type": "duration" },
    "standard": { "$value": "cubic-bezier(0.2, 0.75, 0.25, 1)", "$type": "cubicBezier" }
  },
  "layout": {
    "containerMax": { "$value": "1280px", "$type": "dimension" },
    "desktopColumns": { "$value": 12, "$type": "number" },
    "desktopGutter": { "$value": "24px", "$type": "dimension" },
    "focusRing": { "$value": "0 0 0 3px rgb(250 80 2 / 32%)", "$type": "other" }
  }
}
